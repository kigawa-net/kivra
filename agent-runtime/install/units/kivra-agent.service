# kivra-agent 本体(JVM)。ADR 0010。Restart は異常終了だけ。終了コード 2(設定の誤り)と 3(二重起動)では再起動しない。
# 順序: network / proxy の後(Wants。stub の間は両方が無くても動く。real は preflight が proxy と network を確かめる)。
# STOP ファイル(既定 /var/lib/kivra-agent/work/STOP)が有ると claim しない。止めるのは kivra-agentctl stop。
[Unit]
Description=kivra-agent: ローカルのコーディング attempt 実行エージェント
Documentation=file:///opt/kivra-agent/agent-runtime/README.md
Wants=kivra-agent-network.service kivra-agent-proxy.service
After=docker.service kivra-agent-network.service kivra-agent-proxy.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/kivra-agent/agent.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=DOCKER_HOST=unix://%t/docker.sock
ExecStartPre=/opt/kivra-agent/agent-runtime/install/preflight.sh
ExecStart=/opt/kivra-agent/app/bin/kivra-agent
Restart=on-failure
RestartSec=10s
RestartSteps=6
RestartMaxDelaySec=600
RestartPreventExitStatus=2 3
KillSignal=SIGTERM
TimeoutStopSec=30s
UMask=0077

# 硬化は、名前空間を要しないものだけを付ける。
# 外したもの: ProtectSystem、ProtectHome、PrivateTmp、ReadWritePaths、ProtectKernelTunables、ProtectControlGroups。
# 理由: user manager ではこれらが新しいマウント名前空間で実現される。その中では、ホストの kivra-agent(uid 1001)所有の
# /run/user/1001/docker.sock が別 uid に見え、preflight.sh の docker version が permission denied で失敗する(実機で確認)。
# ルートレス docker と両立しないため外した。書き込み範囲は作業ディレクトリ(0700、kivra-agent 所有)の権限で守る。
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
