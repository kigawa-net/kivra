<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- The agent logs fixed codes plus runId and attemptId only. DEBUG from the HTTP client is off, so no URL or header is logged. -->
    <root level="INFO">
        <appender-ref ref="STDERR" />
    </root>
</configuration>
